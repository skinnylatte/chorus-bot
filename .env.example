# Slack (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...        # Basic Information -> App-Level Tokens (scope: connections:write)

# Model providers. Any provider whose key is missing is skipped at startup.
# OpenRouter covers every vendor with one key (model IDs look like vendor/model).
OPENROUTER_API_KEY=
# Direct vendor keys, only needed for models with provider: anthropic|openai|gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: comma-separated Slack channel IDs the bot will answer in. Unset = any channel it's in.
# DMs are always allowed. Find a channel ID in Slack: channel name -> About -> bottom of the panel.
CHORUS_ALLOWED_CHANNELS=
